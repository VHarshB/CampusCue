# Copy this file to .env and fill it in. Never commit .env.

# From the Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# Optional: your test server's ID, so slash commands show up instantly
DISCORD_GUILD_ID=

# Optional but recommended: lets Rally understand casual answers. Without it, a simple keyword parser is used.
ANTHROPIC_API_KEY=
# RALLY_MODEL=claude-opus-5-5

# Where the database lives. On Railway, point this at the volume, e.g. /data/rally.db
# RALLY_DB_PATH=rally.db

# Port for the web API that CampusCue calls (Railway sets this for you)
# PORT=8080
